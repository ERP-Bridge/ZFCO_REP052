<mvc:View
    controllerName="zfcorep052.controller.RequestDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page id="_IDGenPage2"
        title="Request Details"
        showNavButton="true"
        navButtonPress="onNavBack">

        <content>

            <VBox id="_IDGenVBox" class="sapUiMediumMargin">

                <!-- Header -->

                <HBox id="_IDGenHBox" justifyContent="SpaceBetween">

                    <HBox id="_IDGenHBox1" alignItems="Center">

                        <Label id="_IDGenLabel"
                            text="Request ID:"
                            design="Bold"
                            class="sapUiTinyMarginEnd"/>

                        <Link id="_IDGenLink1" text="{detail>/requestId}"/>

                    </HBox>

                    <ObjectStatus id="_IDGenObjectStatus1"
                        text="{detail>/status}"
                        state="{detail>/statusState}"
                        inverted="true"/>

                </HBox>

                <VBox id="_IDGenVBox1" class="sapUiSmallMarginTop">

                    <Label id="_IDGenLabel1" text="Action Type" design="Bold"/>

                    <Text id="_IDGenText12" text="{detail>/actionTypeDisplay}"/>

                </VBox>

                <!-- Tabs -->

              <IconTabBar
    id="requestObjectTabs"
    expanded="true"
    class="sapUiMediumMarginTop">

    <items>

        <!-- Profit Center -->

        <IconTabFilter id="_IDGenIconTabFilter"
            key="profitCenter"
            text="Profit Center"
            visible="{detail>/visibleTabs/profitCenter}">

            <VBox id="_IDGenVBox2" width="100%">

                <Title id="_IDGenTitle"
                    text="Profit Center Details"
                    level="H4"
                    class="sapUiSmallMarginBottom"/>

                <ScrollContainer id="_IDGenScrollContainer1"
                    width="100%"
                    height="auto"
                    horizontal="true"
                    vertical="false">

                    <VBox
                        id="profitCenterDynamicContent"
                        width="100%"/>

                </ScrollContainer>

            </VBox>

        </IconTabFilter>

        <!-- Geo Site -->

        <IconTabFilter id="_IDGenIconTabFilter1"
            key="geoSite"
            text="Geo Site"
            visible="{detail>/visibleTabs/geoSite}">

            <VBox id="_IDGenVBox3" width="100%">

                <Title id="_IDGenTitle1"
                    text="Geo Site Details"
                    level="H4"
                    class="sapUiSmallMarginBottom"/>

                <ScrollContainer id="_IDGenScrollContainer2"
                    width="100%"
                    height="auto"
                    horizontal="true"
                    vertical="false">

                    <VBox
                        id="geoSiteDynamicContent"
                        width="100%"/>

                </ScrollContainer>

            </VBox>

        </IconTabFilter>

        <!-- Cost Center -->

        <IconTabFilter id="_IDGenIconTabFilter2"
            key="costCenter"
            text="Cost Center"
            visible="{detail>/visibleTabs/costCenter}">

            <VBox id="_IDGenVBox4" width="100%">

                <Title id="_IDGenTitle2"
                    text="Cost Center Details"
                    level="H4"
                    class="sapUiSmallMarginBottom"/>

                <ScrollContainer id="_IDGenScrollContainer3"
                    width="100%"
                    height="auto"
                    horizontal="true"
                    vertical="false">

                    <VBox
                        id="costCenterDynamicContent"
                        width="100%"/>

                </ScrollContainer>

            </VBox>

        </IconTabFilter>

        <!-- Project -->

        <IconTabFilter id="_IDGenIconTabFilter3"
            key="project"
            text="Project"
            visible="{detail>/visibleTabs/project}">

            <VBox id="_IDGenVBox5" width="100%">

                <Title id="_IDGenTitle3"
                    text="Project Details"
                    level="H4"
                    class="sapUiSmallMarginBottom"/>

                <ScrollContainer id="_IDGenScrollContainer4"
                    width="100%"
                    height="auto"
                    horizontal="true"
                    vertical="false">

                    <VBox
                        id="projectDynamicContent"
                        width="100%"/>

                </ScrollContainer>

            </VBox>

        </IconTabFilter>

        <!-- WBS -->

        <IconTabFilter id="_IDGenIconTabFilter4"
            key="wbs"
            text="WBS"
            visible="{detail>/visibleTabs/wbs}">

            <VBox id="_IDGenVBox6" width="100%">

                <Title id="_IDGenTitle4"
                    text="WBS Details"
                    level="H4"
                    class="sapUiSmallMarginBottom"/>

                <ScrollContainer id="_IDGenScrollContainer5"
                    width="100%"
                    height="auto"
                    horizontal="true"
                    vertical="false">

                    <VBox
                        id="wbsDynamicContent"
                        width="100%"/>

                </ScrollContainer>

            </VBox>

        </IconTabFilter>

    </items>

</IconTabBar>
<Link id="_IDGenLink32"
    text="Click to view simulation log"
    visible="{detail>/showSimulationLink}"
    press="onViewSimulationLog"/>
                <!-- Attachments -->

                <Panel id="_IDGenPanel2"
                    headerText="Attachments"
                    class="sapUiMediumMarginTop">

                    <Table id="_IDGenTable1"
                        items="{detail>/attachments}">

                        <columns>

                            <Column id="_IDGenColumn14">
                                <Text id="_IDGenText27" text="File Name"/>
                            </Column>

                            <Column id="_IDGenColumn15">
                                <Text id="_IDGenText28" text="File Type"/>
                            </Column>

                            <Column id="_IDGenColumn16">
                                <Text id="_IDGenText29" text="Size"/>
                            </Column>

                            <Column id="_IDGenColumn17">
                                <Text id="_IDGenText30" text="Uploaded By"/>
                            </Column>

                            <Column id="_IDGenColumn18">
                                <Text id="_IDGenText31" text="Uploaded On"/>
                            </Column>

                            <Column id="_IDGenColumn19">
                                <Text id="_IDGenText32" text="Description"/>
                            </Column>

                        </columns>

                        <items>

                            <ColumnListItem id="_IDGenColumnListItem2">

                                <cells>

                                    <Link id="_IDGenLink2" text="{detail>fileName}"/>

                                    <Text id="_IDGenText33" text="{detail>fileType}"/>

                                    <Text id="_IDGenText34" text="{detail>size}"/>

                                    <Text id="_IDGenText35" text="{detail>uploadedBy}"/>

                                    <Text id="_IDGenText36" text="{detail>uploadedOn}"/>

                                    <Text id="_IDGenText37" text="{detail>description}"/>

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </Panel>

                <!-- Buttons -->

                <HBox id="_IDGenHBox2"
                    justifyContent="Center"
                    class="sapUiLargeMarginTop">
<Button id="_IDGenButton5"
    text="Simulate"
    visible="{detail>/showSimulateButton}"
    press="onSimulate"/>
                    <Button id="_IDGenButton2"
                        text="Validate"
                        type="Accept"
                        press="onValidate"/>

                    <Button id="_IDGenButton3"
                        text="Reject"
                        type="Reject"
                        press="onRejectRequest"
                        class="sapUiTinyMarginBegin sapUiTinyMarginEnd"/>

                    <Button
    id="_IDGenButton4"
    text="Close"
    press="onClose"
    visible="{detail>/showCloseButton}"/>
                </HBox>

            </VBox>

        </content>

    </Page>

</mvc:View>